# Requires Node.js 20.12 or newer.
# Copy this file to ~/.config/tapo.env and replace the example values:
# mkdir -p ~/.config
# cp tapo.env.example ~/.config/tapo.env
# chmod 600 ~/.config/tapo.env
EMAIL="you@example.com"
PASSWORD="your-tapo-password"
DEVICE_IP="192.168.1.100"

# Optional notifications: set both the server base URL and topic to enable.
NTFY_URL=""
NTFY_TOPIC=""
# Optional HTTP Basic authentication (leave blank for an anonymous topic).
NTFY_USER=""
NTFY_PASSWORD=""
